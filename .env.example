# ---- Database (PostgreSQL) ----
# The app connects as a NON-superuser role so Row-Level Security is enforced.
DATABASE_URL="postgresql://cronapp:cronapp@localhost:5432/cronapp?schema=public"

# ---- Redis (BullMQ) ----
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900"          # 15 min (seconds)
JWT_REFRESH_TTL="2592000"     # 30 days (seconds)
JWT_MFA_TTL="300"             # interim 2FA token lifetime, 5 min (seconds)
PASSWORD_RESET_TTL="1800"     # password-reset token lifetime, 30 min (seconds)
APP_URL="http://localhost:3000"  # web console base URL (used in reset links)

# ---- API ----
API_PORT="3001"
CORS_ORIGIN="http://localhost:3000"

# ---- Response storage ----
# driver: "local" (filesystem) or "s3" (MinIO / AWS S3 / R2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# inline small responses below this many bytes directly in Postgres (skip object storage)
STORAGE_INLINE_MAX_BYTES="8192"
# S3 / MinIO (only when STORAGE_DRIVER=s3)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="eu-central-1"
S3_BUCKET="cronapp-responses"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- Scheduler / worker ----
SCHEDULER_TICK_MS="15000"     # how often the scheduler claims due jobs
WORKER_CONCURRENCY="10"       # parallel jobs per worker process
RESPONSE_RETENTION_DAYS="30"  # default; can be overridden per tenant plan
