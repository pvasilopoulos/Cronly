# ---- Database (MySQL / MariaDB) ----
# Tenant isolation is enforced in the application layer (Prisma client extension
# in packages/database), so a plain app user is fine — no special role needed.
DATABASE_URL="mysql://cronapp:cronapp@localhost:3306/cronapp"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="900"          # 15 min (seconds)
JWT_REFRESH_TTL="2592000"     # 30 days (seconds)
JWT_MFA_TTL="300"             # interim 2FA token lifetime, 5 min (seconds)
PASSWORD_RESET_TTL="1800"     # password-reset token lifetime, 30 min (seconds)
APP_URL="http://localhost:3000"  # web console base URL (used in reset links)

# ---- API ----
API_PORT="3001"
CORS_ORIGIN="http://localhost:3000"

# ---- Response storage ----
# driver: "local" (filesystem) or "s3" (MinIO / AWS S3 / R2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# inline small responses below this many bytes directly in the database (skip object storage)
STORAGE_INLINE_MAX_BYTES="8192"
# S3 / MinIO (only when STORAGE_DRIVER=s3)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="eu-central-1"
S3_BUCKET="cronapp-responses"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- Scheduler / worker ----
SCHEDULER_TICK_MS="15000"     # how often the scheduler claims due jobs
WORKER_CONCURRENCY="10"       # parallel jobs per worker process
WORKER_POLL_MS="1000"         # how often each worker polls the DB queue for due runs
RESPONSE_RETENTION_DAYS="30"  # default; can be overridden per tenant plan
